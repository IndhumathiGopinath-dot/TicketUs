<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Ticketus E2E Test Suite

    Each <test> below is a complete user journey through the application.
    Journeys run sequentially (parallel="false") because they may share
    state in the database — running them in parallel would produce flakes.

    Within a journey, @Test methods run in priority order (configured per
    journey class), simulating the linear flow of a real user.
-->
<suite name="TicketusE2ESuite" verbose="1" parallel="false">

    <listeners>
        <listener class-name="com.ticketsystem.e2e.listeners.E2EListener"/>
    </listeners>

    <test name="J01_NewEmployeeLifecycle">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J01_NewEmployeeLifecycle"/>
        </classes>
    </test>

    <test name="J02_ITSupportFullCycle">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J02_ITSupportFullCycle"/>
        </classes>
    </test>

    <test name="J03_CriticalBugFlow">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J03_CriticalBugFlow"/>
        </classes>
    </test>

    <test name="J04_HRConfidentialBoundary">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J04_HRConfidentialBoundary"/>
        </classes>
    </test>

    <test name="J05_KnowledgeBaseFirst">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J05_KnowledgeBaseFirst"/>
        </classes>
    </test>

    <test name="J06_PriorityRoutingMatrix">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J06_PriorityRoutingMatrix"/>
        </classes>
    </test>

    <test name="J07_AdminMultiTicketWorkflow">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J07_AdminMultiTicketWorkflow"/>
        </classes>
    </test>

    <test name="J08_NotificationDelivery">
        <classes>
            <class name="com.ticketsystem.e2e.journeys.J08_NotificationDelivery"/>
        </classes>
    </test>

</suite>
